{
  "manifest_version": 3,
  "name": "SIN",
  "version": "1.0.0",
  "description": "Highlight entertainer names and your own matching rules as you browse.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "extension/icons/icon-16.png",
    "32": "extension/icons/icon-32.png",
    "48": "extension/icons/icon-48.png",
    "128": "extension/icons/icon-128.png"
  },
  "permissions": ["storage", "offscreen", "alarms"],
  "host_permissions": ["https://pluginu.github.io/*"],
  "background": {"service_worker": "extension/background.js", "type": "module"},
  "action": {
    "default_popup": "extension/popup.html",
    "default_title": "SIN",
    "default_icon": {
      "16": "extension/icons/icon-16.png",
      "32": "extension/icons/icon-32.png",
      "48": "extension/icons/icon-48.png",
      "128": "extension/icons/icon-128.png"
    }
  },
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["extension/content.js"], "css": ["extension/highlight.css"], "all_frames": true, "run_at": "document_idle"}]
}
