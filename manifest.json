{
  "manifest_version": 3,
  "name": "SIN — Name Highlighter",
  "version": "1.0.0",
  "description": "Highlight entertainer names and your own matching rules as you browse.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "offscreen"],
  "background": {"service_worker": "extension/background.js", "type": "module"},
  "action": {"default_popup": "extension/popup.html", "default_title": "SIN highlighter"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["extension/content.js"], "css": ["extension/highlight.css"], "all_frames": true, "run_at": "document_idle"}]
}
